{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    },
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router (homelab gateway)",
      "options": {
        "baseURL": "{env:NINEROUTER_URL}/v1",
        "apiKey": "{env:NINEROUTER_KEY}"
      },
      "models": {
        "free-forever": {
          "name": "Free Forever"
        },
        "coding":{
          "name": "Coding"
        },
        "small-task":{
          "name": "Bug fix"
        },
        "architect":{
          "name": "Architect"
        },
        "premium":{
          "name": "Premium"
        }
      }
    },
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local",
      "options": {
        "baseURL": "http://192.168.10.51:11434/v1"
      },
      "models": {
        "qwen3:14b-default": {
          "name": "Qwen 3"
        },
        "qwen3:14b-large": {
          "name": "Qwen 3 Large"
        },
        "qwen3:14b": {
          "name": "Qwen 3 Fast"
        },
        "gpt-oss:20b-large": {
          "name": "GPT OSS Large"
        },
        "gpt-oss:20b-default": {
          "name": "GPT OSS"
        },
        "gpt-oss:20b-fast": {
          "name": "GPT OSS"
        },
        "gemma4:12b-ultra":{
          "name": "Gemma 4"
        },
        "gemma4:26b":{
          "name": "Gemma 4 26B"
        }
      }
    }
  }
}
